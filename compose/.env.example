# Copy to .env, swap 192.168.1.10 for your server, and fill in the blanks.

# Home Assistant, with a long-lived access token (Profile → Security).
HASS_URL=http://192.168.1.10:8123
HASS_TOKEN=

# The MQTT broker Frigate publishes to.
MQTT_BROKER=tcp://192.168.1.10:1883
MQTT_USERNAME=frigate-notify
MQTT_PASSWORD=

# Frigate's unauthenticated API, port 5000: pictures come from here.
MEDIA_FRIGATE_URL=http://192.168.1.10:5000
# Where phones load pictures: this host's port 8081, which works at home. For
# away from home, Slack and Discord, use a public HTTPS URL that proxies to it.
MEDIA_PUBLIC_BASE_URL=http://192.168.1.10:8081
# Signs picture links: openssl rand -hex 32
MEDIA_SIGNING_KEY=

TIMEZONE=America/New_York

# Only for ntfy or Slack targets.
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=
# SLACK_BOT_TOKEN=

# Letters and digits only, set before the first start: PostgreSQL keeps the
# password it was created with.
POSTGRES_PASSWORD=change-me
